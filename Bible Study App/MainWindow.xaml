        <DataTemplate x:Key="BibleBookCardTemplate">
            <Button Style="{DynamicResource PaperCardButtonStyle}"
                    Click="BibleBook_Click"
                    Tag="{Binding}"
                    Margin="0,0,18,18">
                <Grid Width="208"
                      Height="138">
                    <Border Background="#050505"
                            BorderBrush="#050505"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,10,10,0" />
                    <Border x:Name="BibleBookPaperSheet"
                            Width="196"
                            Height="126"
                            Background="{DynamicResource TextPrimary}"
                            BorderBrush="#111111"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            Padding="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BibleBookPaperSheetTransform" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Name}"
                                       Foreground="#111111"
                                       FontSize="18"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding ChapterLabel}"
                                       Foreground="{DynamicResource PanelBackground}"
                                       FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BibleBookPaperSheetTransform"
                                                 Storyboard.TargetProperty="X"
                                                 To="6"
                                                 Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="BibleBookPaperSheetTransform"
                                                 Storyboard.TargetProperty="Y"
                                                 To="-6"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BibleBookPaperSheetTransform"
                                                 Storyboard.TargetProperty="X"
                                                 To="0"
                                                 Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="BibleBookPaperSheetTransform"
                                                 Storyboard.TargetProperty="Y"
                                                 To="0"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </DataTemplate>

