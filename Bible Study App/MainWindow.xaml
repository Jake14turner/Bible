                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource PanelBackground}"
                            CornerRadius="14"
                            Padding="14,11"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="PASSAGE PREVIEW"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       FontWeight="Black" />
                            <TextBlock x:Name="StudyPassageModalPreviewText"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Style="{StaticResource ChromeButtonStyle}"
                                Content="Cancel"
                                Padding="18,10"
                                Click="CloseStudyPassageModal_Click" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Apply passage"
                                Padding="20,10"
                                Margin="10,0,0,0"
                                Click="ApplyStudyPassageModal_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Popup x:Name="SelectionActionPopup"
               AllowsTransparency="True"
               Placement="MousePoint"
               HorizontalOffset="-18"
               VerticalOffset="-35"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Canvas x:Name="SelectionActionMenuRoot"
                    Width="205" Height="135" Margin="8" Background="Transparent"
                    MouseLeave="SelectionActionMenu_MouseLeave">
                <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                </Canvas.LayoutTransform>
                <Path x:Name="SelectionActionCurve"
                      Data="M 30,35 C 80,35 145,65 175,105"
                      Stroke="{DynamicResource AppBackground}"
                      StrokeThickness="46"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round">
                    <Path.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.42" />
                    </Path.Effect>
                </Path>
                    <Button x:Name="SelectionHighlightButton" Style="{StaticResource SelectionActionButtonStyle}" Width="38" Height="38"
                            Canvas.Left="6" Canvas.Top="6" Background="{DynamicResource PanelBackground}"
                            ToolTip="Highlight" MouseEnter="SelectionActionButton_MouseEnter" Click="SelectionHighlight_Click">
                        <TextBlock Text="▰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SelectionCopyButton" Style="{StaticResource SelectionActionButtonStyle}" Width="38" Height="38"
                            Canvas.Left="50" Canvas.Top="12" Background="{DynamicResource PanelBackground}"
                            ToolTip="Copy" MouseEnter="SelectionActionButton_MouseEnter" Click="SelectionCopy_Click">
                        <TextBlock Text="⧉" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SelectionPasteButton" Style="{StaticResource SelectionActionButtonStyle}" Width="38" Height="38"
                            Canvas.Left="91" Canvas.Top="34" Background="{DynamicResource PanelBackground}"
                            ToolTip="Paste" MouseEnter="SelectionActionButton_MouseEnter" Click="SelectionPaste_Click">
                        <TextBlock Text="▣" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SelectionAddNoteButton" Style="{StaticResource SelectionActionButtonStyle}" Width="38" Height="38"
                            Canvas.Left="126" Canvas.Top="67" Background="{DynamicResource PanelBackground}"
                            ToolTip="Add note" MouseEnter="SelectionActionButton_MouseEnter" Click="SelectionAddNote_Click">
                        <TextBlock Text="＋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SelectionDeleteHighlightButton" Style="{StaticResource SelectionActionButtonStyle}" Width="38" Height="38"
                            Canvas.Left="153" Canvas.Top="106" Background="{DynamicResource PanelBackground}"
                            ToolTip="Remove highlight" MouseEnter="SelectionActionButton_MouseEnter" Click="SelectionDeleteHighlight_Click">
                        <TextBlock Text="◇" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SelectionDeleteNoteButton" Style="{StaticResource SelectionActionButtonStyle}" Width="38" Height="38"
                            Canvas.Left="181" Canvas.Top="146" Background="{DynamicResource PanelBackground}"
                            ToolTip="Delete note" MouseEnter="SelectionActionButton_MouseEnter" Click="SelectionDeleteNote_Click">
                        <TextBlock Text="−" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
            </Canvas>
        </Popup>

        <Popup x:Name="WorkspaceItemActionPopup"
               AllowsTransparency="True"
               Placement="MousePoint"
               HorizontalOffset="-18"
               VerticalOffset="-35"
               StaysOpen="False"
               PopupAnimation="Fade"
               Closed="WorkspaceItemActionPopup_Closed">
            <Canvas x:Name="WorkspaceItemActionMenuRoot"
                    Width="112" Height="78" Margin="8" Background="Transparent"
                    MouseLeave="WorkspaceItemActionMenu_MouseLeave">
                <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                </Canvas.LayoutTransform>
                <Path Data="M 30,35 C 48,35 72,42 91,55"
                      Stroke="{DynamicResource AppBackground}"
                      StrokeThickness="46"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round">
                    <Path.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.42" />
                    </Path.Effect>
                </Path>
                <Button x:Name="WorkspaceItemRenameButton"
                        Style="{StaticResource SelectionActionButtonStyle}"
                        Width="38" Height="38"
                        Canvas.Left="10" Canvas.Top="15"
                        Background="{DynamicResource PanelBackground}"
                        ToolTip="Rename"
                        MouseEnter="WorkspaceItemActionButton_MouseEnter"
                        Click="WorkspaceItemRename_Click">
                    <TextBlock Text="✎" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="WorkspaceItemDeleteButton"
                        Style="{StaticResource SelectionActionButtonStyle}"
                        Width="38" Height="38"
                        Canvas.Left="54" Canvas.Top="27"
                        Background="{DynamicResource PanelBackground}"
                        ToolTip="Delete"
                        MouseEnter="WorkspaceItemActionButton_MouseEnter"
                        Click="WorkspaceItemDelete_Click">
                    <TextBlock Text="−" FontSize="20" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Canvas>
        </Popup>

        <Popup x:Name="HighlightColorPopup"
               PlacementTarget="{Binding ElementName=SelectionHighlightButton}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               Closed="SelectionSubmenu_Closed"
               PopupAnimation="Fade">
            <Border x:Name="HighlightColorCard"
                    Background="{DynamicResource AppBackground}"
                    CornerRadius="18,18,18,6"
                    Padding="10"
                    Margin="5">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.38" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Highlight color" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" FontWeight="Bold" Margin="4,0,4,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource HighlightSwatchStyle}" Tag="#F4C95D" Background="#F4C95D" Click="HighlightColor_Click" />
                        <Button Style="{StaticResource HighlightSwatchStyle}" Tag="#F28B82" Background="#F28B82" Click="HighlightColor_Click" />
                        <Button Style="{StaticResource HighlightSwatchStyle}" Tag="#81C995" Background="#81C995" Click="HighlightColor_Click" />
                        <Button Style="{StaticResource HighlightSwatchStyle}" Tag="#78D9EC" Background="#78D9EC" Click="HighlightColor_Click" />
                        <Button Style="{StaticResource HighlightSwatchStyle}" Tag="#AECBFA" Background="#AECBFA" Click="HighlightColor_Click" />
                        <Button Style="{StaticResource HighlightSwatchStyle}" Tag="#D7AEFB" Background="#D7AEFB" Click="HighlightColor_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="AnnotationNotePopup"
               PlacementTarget="{Binding ElementName=SelectionAddNoteButton}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               Closed="AnnotationNotePopup_Closed">
            <Border x:Name="AnnotationNoteCard"
                    Style="{StaticResource NoteSurfaceStyle}"
                    Width="340"
                    Margin="8"
                    Opacity="{StaticResource FloatingSurfaceHiddenOpacity}"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AnnotationNoteCardScale"
                                        ScaleX="{StaticResource FloatingSurfaceHiddenScale}"
                                        ScaleY="{StaticResource FloatingSurfaceHiddenScale}" />
                        <TranslateTransform x:Name="AnnotationNoteCardTranslate"
                                            Y="{StaticResource FloatingSurfaceHiddenOffset}" />
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="Note for this text"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="17"
                               FontWeight="Black"
                               Margin="4,0,4,10" />
                    <Border Background="{DynamicResource PanelBackground}"
                            CornerRadius="16"
                            Padding="12">
                        <TextBox x:Name="AnnotationNoteTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="92"
                                 MaxHeight="150"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource Mint}"
                                 FontSize="14"
                                 Padding="0"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Style="{StaticResource SelectionActionButtonStyle}"
                                Width="82" Height="38" Content="Cancel" Padding="0"
                                HorizontalContentAlignment="Center"
                                Click="AnnotationNoteCancel_Click" />
                        <Button Style="{StaticResource SelectionActionButtonStyle}"
                                Width="100" Height="38" Margin="8,0,0,0"
                                Background="{DynamicResource Mint}"
                                Foreground="{DynamicResource AppBackground}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                Content="Save note"
                                Click="AnnotationNoteSave_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SavedNotePopup"
               Placement="MousePoint"
               HorizontalOffset="10"
               VerticalOffset="14"
               AllowsTransparency="True"
               StaysOpen="False"
               Closed="SavedNotePopup_Closed">
            <Border x:Name="SavedNoteCard"
                    Style="{StaticResource NoteSurfaceStyle}"
                    Width="340"
                    Margin="8"
                    Opacity="{StaticResource FloatingSurfaceHiddenOpacity}"
                    RenderTransformOrigin="0.5,0"
                    MouseEnter="SavedNoteCard_MouseEnter"
                    MouseLeave="SavedNoteCard_MouseLeave">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SavedNoteCardScale"
                                        ScaleX="{StaticResource FloatingSurfaceHiddenScale}"
                                        ScaleY="{StaticResource FloatingSurfaceHiddenScale}" />
                        <TranslateTransform x:Name="SavedNoteCardTranslate"
                                            Y="{StaticResource FloatingSurfaceHiddenOffset}" />
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="Note for this text"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="17"
                               FontWeight="Black"
                               Margin="4,0,4,10" />
                    <Border Background="{DynamicResource PanelBackground}"
                            CornerRadius="16"
                            Padding="12">
                        <TextBox x:Name="SavedNoteTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="92"
                                 MaxHeight="150"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource Mint}"
                                 FontSize="14"
                                 Padding="0"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Border>
                    <StackPanel x:Name="SavedNoteViewActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Style="{StaticResource SelectionActionButtonStyle}"
                                Width="82" Height="38" Content="Delete" Padding="0"
                                HorizontalContentAlignment="Center"
                                Click="SavedNoteDelete_Click" />
                        <Button Style="{StaticResource SelectionActionButtonStyle}"
                                Width="82" Height="38" Margin="8,0,0,0"
                                Background="{DynamicResource Mint}"
                                Foreground="{DynamicResource AppBackground}"
                                Content="Edit" Padding="0"
                                HorizontalContentAlignment="Center"
                                Click="SavedNoteEdit_Click" />
                    </StackPanel>
                    <StackPanel x:Name="SavedNoteEditActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                        <Button Style="{StaticResource SelectionActionButtonStyle}"
                                Width="82" Height="38" Content="Cancel" Padding="0"
                                HorizontalContentAlignment="Center"
                                Click="SavedNoteEditCancel_Click" />
                        <Button Style="{StaticResource SelectionActionButtonStyle}"
                                Width="100" Height="38" Margin="8,0,0,0"
                                Background="{DynamicResource Mint}"
                                Foreground="{DynamicResource AppBackground}"
                                Content="Save note" Padding="0"
                                HorizontalContentAlignment="Center"
                                Click="SavedNoteSave_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="ToastHost"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,28,0"
                Background="{DynamicResource AppBackground}"
                BorderBrush="{DynamicResource Mint}"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="14,10"
                MaxWidth="360"
                Opacity="0"
                Visibility="Collapsed"
                Panel.ZIndex="500"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastHostTransform"
                                    X="28"
                                    Y="-8" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="0"
                                  ShadowDepth="5"
                                  Direction="315"
                                  Opacity="0.45" />
            </Border.Effect>
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource TextPrimary}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>

