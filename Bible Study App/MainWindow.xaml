                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,11,0,0">
                                            <TextBlock x:Name="MemoryAttemptPhaseText"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,9,0" />
                                            <Ellipse x:Name="MemoryAttemptDotOne"
                                                     Width="7" Height="7" Margin="0,0,5,0"
                                                     Stroke="{DynamicResource TextMuted}" StrokeThickness="1" />
                                            <Ellipse x:Name="MemoryAttemptDotTwo"
                                                     Width="7" Height="7" Margin="0,0,5,0"
                                                     Stroke="{DynamicResource TextMuted}" StrokeThickness="1" />
                                            <Ellipse x:Name="MemoryAttemptDotThree"
                                                     Width="7" Height="7"
                                                     Stroke="{DynamicResource TextMuted}" StrokeThickness="1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid x:Name="MemoryPassageModalOverlay"
                              Panel.ZIndex="900"
                              Background="#B8000000"
                              Visibility="Collapsed"
                              Focusable="True"
                              PreviewKeyDown="MemoryPassageModalOverlay_PreviewKeyDown"
                              MouseLeftButtonDown="MemoryPassageModalOverlay_MouseLeftButtonDown">
                            <Border x:Name="MemoryPassageModalCard"
                                    Style="{StaticResource NoteSurfaceStyle}"
                                    Width="700"
                                    Padding="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="MemoryPassageModalScale" ScaleX="0.94" ScaleY="0.94" />
                                        <TranslateTransform x:Name="MemoryPassageModalTranslate" Y="10" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <StackPanel>
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Choose a passage"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="23"
                                                       FontWeight="Black" />
                                            <TextBlock Text="Pick one verse or continue through another chapter."
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="13"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="38" Height="38" Padding="0"
                                                Content="×"
                                                Click="MemoryClosePassageModal_Click" />
                                    </Grid>

                                    <StackPanel Margin="0,0,0,18">
                                        <TextBlock Text="Book"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="2,0,0,6" />
                                        <ComboBox x:Name="MemoryModalBookSelect"
                                                  Style="{StaticResource PolishedComboBoxStyle}"
                                                  Height="44"
                                                  Background="{DynamicResource PanelBackground}"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  BorderBrush="{DynamicResource StrokeSoft}"
                                                  SelectionChanged="MemoryModalBookSelect_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource PanelBackground}"
                                                CornerRadius="16"
                                                Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="FROM"
                                                           Foreground="{DynamicResource Mint}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           Margin="0,0,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Chapter" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="1,0,0,5" />
                                                        <ComboBox x:Name="MemoryFromChapterSelect"
                                                                  Style="{StaticResource PolishedComboBoxStyle}"
                                                                  Height="42"
                                                                  Background="{DynamicResource AppBackground}"
                                                                  Foreground="{DynamicResource TextPrimary}"
                                                                  SelectionChanged="MemoryFromChapterSelect_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Verse" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="1,0,0,5" />
                                                        <ComboBox x:Name="MemoryFromVerseSelect"
                                                                  Style="{StaticResource PolishedComboBoxStyle}"
                                                                  Height="42"
                                                                  Background="{DynamicResource AppBackground}"
                                                                  Foreground="{DynamicResource TextPrimary}"
                                                                  SelectionChanged="MemoryModalRange_SelectionChanged" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="→"
                                                   Foreground="{DynamicResource Mint}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource PanelBackground}"
                                                CornerRadius="16"
                                                Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="THROUGH"
                                                           Foreground="{DynamicResource Mint}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           Margin="0,0,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Chapter" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="1,0,0,5" />
                                                        <ComboBox x:Name="MemoryThroughChapterSelect"
                                                                  Style="{StaticResource PolishedComboBoxStyle}"
                                                                  Height="42"
                                                                  Background="{DynamicResource AppBackground}"
                                                                  Foreground="{DynamicResource TextPrimary}"
                                                                  SelectionChanged="MemoryThroughChapterSelect_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Verse" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="1,0,0,5" />
                                                        <ComboBox x:Name="MemoryThroughVerseSelect"
                                                                  Style="{StaticResource PolishedComboBoxStyle}"
                                                                  Height="42"
                                                                  Background="{DynamicResource AppBackground}"
                                                                  Foreground="{DynamicResource TextPrimary}"
                                                                  SelectionChanged="MemoryModalRange_SelectionChanged" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource PanelBackground}"
                                            CornerRadius="14"
                                            Padding="14,11"
                                            Margin="0,18,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Selected"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,12,0" />
                                            <TextBlock x:Name="MemoryModalPassagePreview"
                                                       Grid.Column="1"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="Black"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,20,0,0">
                                        <Button Style="{StaticResource ChromeButtonStyle}"
                                                Content="Cancel"
                                                Padding="18,10"
                                                Click="MemoryClosePassageModal_Click" />
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Content="Add to memory"
                                                Padding="20,10"
                                                Margin="10,0,0,0"
                                                Click="MemoryAddPassage_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="LibraryPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="All Bible Books"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="24"
                                           FontWeight="Bold" />
                                <TextBlock Text="Choose a book to open its study workspace."
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="{DynamicResource PanelBackground}"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="Old Testament"
                                               Foreground="{DynamicResource Gold}"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{DynamicResource PanelBackground}"
                                        CornerRadius="14"
                                        Padding="12,8">
                                    <TextBlock Text="New Testament"
                                               Foreground="{DynamicResource Sky}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="BibleBooksScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="BibleBooksScrollViewer_PreviewMouseWheel">
                            <StackPanel>
                                <Expander x:Name="OldTestamentBooksExpander"
                                          Style="{StaticResource TestamentExpanderStyle}"
                                          IsExpanded="True"
                                          Loaded="TestamentBooksExpander_Loaded"
                                          Expanded="TestamentBooksExpander_StateChanged"
                                          Collapsed="TestamentBooksExpander_StateChanged"
                                          Margin="0,0,0,18"
                                          Foreground="{DynamicResource TextPrimary}">
                                    <Expander.Header>
                                        <TextBlock Text="Old Testament"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Margin="0,0,0,10" />
                                    </Expander.Header>
                                    <ItemsControl x:Name="OldTestamentBooksItems"
                                                  ItemTemplate="{StaticResource BibleBookCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>

                                <Expander x:Name="NewTestamentBooksExpander"
                                          Style="{StaticResource TestamentExpanderStyle}"
                                          IsExpanded="True"
                                          Loaded="TestamentBooksExpander_Loaded"
                                          Expanded="TestamentBooksExpander_StateChanged"
                                          Collapsed="TestamentBooksExpander_StateChanged"
                                          Foreground="{DynamicResource TextPrimary}">
                                    <Expander.Header>
                                        <TextBlock Text="New Testament"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Margin="0,0,0,10" />
                                    </Expander.Header>
                                    <ItemsControl x:Name="NewTestamentBooksItems"
                                                  ItemTemplate="{StaticResource BibleBookCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="WorkspacePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Background="{DynamicResource PanelBackground}"
                                    Click="BackOneLevel_Click"
                                    ToolTip="Back">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource ChevronLeftIcon}"
                                          Stroke="{DynamicResource TextPrimary}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Button>
                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="WorkspaceTitle"
                                         
                                           FontSize="27"
                                           FontWeight="Black" />
                                <TextBlock x:Name="WorkspaceSubtitle"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource ChromeButtonStyle}"
                                        Background="{DynamicResource PanelBackground}"
                                        Click="AddFolder_Click"
                                        Height="50"
                                        Padding="18,0"
                                        Margin="0,0,8,0"
                                        ToolTip="Create folder">
                                    <TextBlock Text="Add Folder"
                                               FontWeight="Bold" />
                                </Button>
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Click="AddStudy_Click"
                                        Height="50"
                                        Padding="18,0"
                                        ToolTip="Create study">
                                    <TextBlock Text="Add Study"
                                               FontWeight="Black" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource AppBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="20">
                            <Grid>
                                <TextBlock x:Name="EmptyWorkspaceText"
                                           Text="Use the plus button to add a folder or study."
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="WorkspaceItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PaperCardButtonStyle}"
                                                        Click="WorkspaceItem_Click"
                                                        PreviewMouseRightButtonDown="WorkspaceItem_PreviewMouseRightButtonDown"
                                                        Tag="{Binding}"
                                                        Margin="0,0,18,18">
                                                    <Grid Width="208"
                                                          Height="138">
                                                        <Border Background="#050505"
                                                                BorderBrush="#050505"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Margin="0,10,10,0" />
                                                        <Border x:Name="PaperSheet"
                                                                Width="196"
                                                                Height="126"
                                                                Background="{DynamicResource TextPrimary}"
                                                                BorderBrush="#111111"
                                                                BorderThickness="1.5"
                                                                CornerRadius="4"
                                                                Padding="16"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform x:Name="PaperSheetTransform" />
                                                            </Border.RenderTransform>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Text="{Binding KindLabel}"
                                                                           Foreground="#111111"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Margin="0,0,0,8" />
                                                                <Grid Grid.Row="1"
                                                                      VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Visibility="{Binding DisplayNameVisibility}"
                                                                               Foreground="#111111"
                                                                               FontSize="18"
                                                                               FontWeight="Black"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Tag="{Binding}"
                                                                             Visibility="{Binding RenameTextBoxVisibility}"
                                                                             Background="{DynamicResource TextPrimary}"
                                                                             BorderBrush="#111111"
                                                                             BorderThickness="1"
                                                                             Foreground="#111111"
                                                                             CaretBrush="#111111"
                                                                             FontSize="18"
                                                                             FontWeight="Black"
                                                                             Padding="8,4"
                                                                             MinHeight="34"
                                                                             MaxLength="80"
                                                                             Loaded="WorkspaceRenameTextBox_Loaded"
                                                                             PreviewMouseDown="WorkspaceRenameTextBox_PreviewMouseDown"
                                                                             PreviewKeyDown="WorkspaceRenameTextBox_PreviewKeyDown"
                                                                             LostKeyboardFocus="WorkspaceRenameTextBox_LostKeyboardFocus" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding DetailLabel}"
                                                                           Foreground="{DynamicResource PanelBackground}"
                                                                           FontSize="12" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    <Button.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PaperSheetTransform"
                                                                                     Storyboard.TargetProperty="X"
                                                                                     To="6"
                                                                                     Duration="0:0:0.12" />
                                                                    <DoubleAnimation Storyboard.TargetName="PaperSheetTransform"
                                                                                     Storyboard.TargetProperty="Y"
                                                                                     To="-6"
                                                                                     Duration="0:0:0.12" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PaperSheetTransform"
                                                                                     Storyboard.TargetProperty="X"
                                                                                     To="0"
                                                                                     Duration="0:0:0.12" />
                                                                    <DoubleAnimation Storyboard.TargetName="PaperSheetTransform"
                                                                                     Storyboard.TargetProperty="Y"
                                                                                     To="0"
                                                                                     Duration="0:0:0.12" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="StudyPanel"
                          Visibility="Collapsed"
                          SizeChanged="StudyPanel_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="StudyEditorColumn" Width="*" MinWidth="240" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition x:Name="ScriptureColumn" Width="0" MinWidth="0" MaxWidth="0" />
                            <ColumnDefinition x:Name="StrongsSplitterColumn" Width="0" />
                            <ColumnDefinition x:Name="StrongsColumn" Width="0" MinWidth="0" MaxWidth="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Canvas x:Name="ExtraStudyPanelLayer"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Panel.ZIndex="9200"
                                ClipToBounds="True" />

                        <Border x:Name="StudyEditorPanelRoot"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AppBackground}"
                                BorderBrush="{DynamicResource SidebarBackground}"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                Padding="0"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True"
                                PreviewMouseDown="PanelRoot_PreviewMouseDown">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="StudyEditorPanelDragTransform"
                                                        X="0"
                                                        Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Height="30"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        Cursor="SizeAll"
                                        Panel.ZIndex="60"
                                        PreviewMouseLeftButtonDown="PanelDragHandle_MouseLeftButtonDown"
                                        PreviewMouseMove="PanelDragHandle_MouseMove"
                                        PreviewMouseLeftButtonUp="PanelDragHandle_MouseLeftButtonUp" />
                                <Grid Margin="0"
                                      Panel.ZIndex="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <AdornerDecorator Grid.Row="1">
                                    <ScrollViewer x:Name="StudyEditorScrollViewer"
                                                  Margin="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="StudyEditorScrollViewer_PreviewMouseWheel">
                                        <ItemsControl x:Name="StudyBlockItems"
                                                      Margin="4,0,24,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding BackgroundBrush}"
                                                            BorderBrush="{Binding BorderBrush}"
                                                            BorderThickness="{Binding BorderThickness}"
                                                            Padding="{Binding Padding}"
                                                            Margin="{Binding Margin}"
                                                            MinHeight="{Binding MinHeight}"
                                                            CornerRadius="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding MarkerWidth}" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding MarkerText}"
                                                                       Visibility="{Binding MarkerVisibility}"
                                                                       Foreground="{Binding MarkerBrush}"
                                                                       FontSize="{Binding MarkerFontSize}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Top"
                                                                       Margin="0,-2,10,0" />

                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Visibility="{Binding CheckboxVisibility}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,3,10,0"
                                                                      Checked="StudyBlock_CheckChanged"
                                                                      Unchecked="StudyBlock_CheckChanged" />

                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Tag="{Binding}"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     BorderThickness="0"
                                                                     Background="Transparent"
                                                                     Foreground="{Binding ForegroundBrush}"
                                                                     CaretBrush="Transparent"
                                                                     FontSize="{Binding FontSize}"
                                                                     FontWeight="{Binding FontWeight}"
                                                                     FontStyle="{Binding FontStyle}"
                                                                     FontFamily="{Binding FontFamily}"
                                                                     Padding="0"
                                                                     MinHeight="{Binding TextMinHeight}"
                                                                     SpellCheck.IsEnabled="True"
                                                                     UndoLimit="80"
                                                                     Loaded="SelectableText_Loaded"
                                                                     TextChanged="StudyBlock_TextChanged"
                                                                     SelectionChanged="StudyBlock_SelectionChanged"
                                                                     PreviewMouseLeftButtonUp="SelectableText_PreviewMouseLeftButtonUp"
                                                                     PreviewMouseMove="SelectableText_PreviewMouseMove"
                                                                     PreviewKeyDown="StudyBlock_PreviewKeyDown"
                                                                     KeyUp="StudyBlock_KeyUp"
                                                                     GotKeyboardFocus="StudyBlock_GotKeyboardFocus"
                                                                     LostKeyboardFocus="StudyBlock_LostKeyboardFocus">
                                                                <TextBox.Template>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                                    </ControlTemplate>
                                                                </TextBox.Template>
                                                            </TextBox>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    </AdornerDecorator>
                                    <Canvas x:Name="StudyEditorCaretLayer"
                                            Grid.Row="1"
                                            Panel.ZIndex="25"
                                            IsHitTestVisible="False"
                                            ClipToBounds="True"
                                            Margin="4,0,24,0">
                                        <Border x:Name="SmoothEditorCaret"
                                                Width="2.25"
                                                Height="20"
                                                Background="{DynamicResource Mint}"
                                                CornerRadius="1.2"
                                                Visibility="Collapsed" />
                                    </Canvas>

                                    <Border Grid.Row="2"
                                            Background="{DynamicResource AppBackground}"
                                            BorderBrush="{DynamicResource StrokeSoft}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="4,12,14,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
