                                            <StackPanel>
                                                <TextBlock Text="Downloaded model" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Black" />
                                                <TextBlock Text="The backend starts Ollama automatically and lists models already downloaded on this computer."
                                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,16,0" />
                                            </StackPanel>
                                            <Button x:Name="RefreshAiModelsButton" Grid.Column="1" Style="{StaticResource ChromeButtonStyle}"
                                                    Padding="12,8" VerticalAlignment="Top" Click="RefreshAiModels_Click" Content="Refresh" />
                                        </Grid>
                                        <ComboBox x:Name="AiModelComboBox" Margin="0,14,0,0" MinHeight="42"
                                                  Style="{StaticResource PolishedComboBoxStyle}"
                                                  SelectionChanged="AiModelComboBox_SelectionChanged" />
                                        <TextBlock x:Name="AiModelStatusText" Text="Checking Ollama status..." Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ColorThemeSettingsPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="760"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Pick a saved scheme or create a custom one."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,22" />

                                    <ItemsControl x:Name="ColorSchemePresetItems"
                                                  Margin="0,0,0,24">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppBackground}"
                                                    BorderBrush="{DynamicResource PanelBackground}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontWeight="Black"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <Grid Grid.Column="1"
                                                          Height="30"
                                                          Margin="12,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{Binding AppBackgroundBrush}"
                                                                CornerRadius="5,0,0,5" />
                                                        <Border Grid.Column="1"
                                                                Background="{Binding PanelBackgroundBrush}" />
                                                        <Border Grid.Column="2"
                                                                Background="{Binding AccentBrush}" />
                                                        <Border Grid.Column="3"
                                                                Background="{Binding TextPrimaryBrush}" />
                                                        <Border Grid.Column="4"
                                                                Background="{Binding TextSecondaryBrush}"
                                                                CornerRadius="0,5,5,0" />
                                                    </Grid>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource ChromeButtonStyle}"
                                                            Padding="14,8"
                                                            Margin="0,0,8,0"
                                                            Tag="{Binding}"
                                                            Click="ApplyColorScheme_Click"
                                                            Content="Apply" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource RemoveButtonStyle}"
                                                            Width="70"
                                                            Height="34"
                                                            Tag="{Binding}"
                                                            Click="DeleteColorScheme_Click"
                                                            Content="Delete" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                    <TextBlock Text="New preset"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Margin="0,8,0,12" />
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewColorSchemeNameTextBox"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource PanelBackground}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 CaretBrush="{DynamicResource Mint}"
                                                 Padding="10"
                                                 Margin="0,0,10,0"
                                                 Text="Custom" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Padding="18,8"
                                                Click="AddColorScheme_Click"
                                                Content="Add preset" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="App background"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ChromeButtonStyle}"
                                                Padding="8"
                                                Margin="0,0,10,0"
                                                Tag="{Binding ElementName=NewAppBackgroundTextBox}"
                                                Click="PickColor_Click">
                                            <Border x:Name="NewAppBackgroundSwatch"
                                                    Width="130"
                                                    Height="28"
                                                    CornerRadius="5"
                                                    Background="#283618" />
                                        </Button>
                                        <TextBox x:Name="NewAppBackgroundTextBox"
                                                 Grid.Column="2"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource PanelBackground}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 CaretBrush="{DynamicResource Mint}"
                                                 Padding="10"
                                                 Text="#283618"
                                                 TextChanged="ColorHex_TextChanged" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Panel background"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ChromeButtonStyle}"
                                                Padding="8"
                                                Margin="0,0,10,0"
                                                Tag="{Binding ElementName=NewPanelBackgroundTextBox}"
                                                Click="PickColor_Click">
                                            <Border x:Name="NewPanelBackgroundSwatch"
                                                    Width="130"
                                                    Height="28"
                                                    CornerRadius="5"
                                                    Background="#606C38" />
                                        </Button>
                                        <TextBox x:Name="NewPanelBackgroundTextBox"
                                                 Grid.Column="2"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource PanelBackground}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 CaretBrush="{DynamicResource Mint}"
                                                 Padding="10"
                                                 Text="#606C38"
                                                 TextChanged="ColorHex_TextChanged" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Accent"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ChromeButtonStyle}"
                                                Padding="8"
                                                Margin="0,0,10,0"
                                                Tag="{Binding ElementName=NewAccentTextBox}"
                                                Click="PickColor_Click">
                                            <Border x:Name="NewAccentSwatch"
                                                    Width="130"
                                                    Height="28"
                                                    CornerRadius="5"
                                                    Background="#DDA15E" />
                                        </Button>
                                        <TextBox x:Name="NewAccentTextBox"
                                                 Grid.Column="2"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource PanelBackground}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 CaretBrush="{DynamicResource Mint}"
                                                 Padding="10"
                                                 Text="#DDA15E"
                                                 TextChanged="ColorHex_TextChanged" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Text"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ChromeButtonStyle}"
                                                Padding="8"
                                                Margin="0,0,10,0"
                                                Tag="{Binding ElementName=NewTextPrimaryTextBox}"
                                                Click="PickColor_Click">
                                            <Border x:Name="NewTextPrimarySwatch"
                                                    Width="130"
                                                    Height="28"
                                                    CornerRadius="5"
                                                    Background="#FEFAE0" />
                                        </Button>
                                        <TextBox x:Name="NewTextPrimaryTextBox"
                                                 Grid.Column="2"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource PanelBackground}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 CaretBrush="{DynamicResource Mint}"
                                                 Padding="10"
                                                 Text="#FEFAE0"
                                                 TextChanged="ColorHex_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ScriptureMemoryPanel" Visibility="Collapsed">
                        <Grid x:Name="MemoryLibraryView">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="8,0,8,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Your passages"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="22"
                                               FontWeight="Black" />
                                    <TextBlock Text="Practice a saved passage or add a new one."
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="Add passage"
                                        Padding="20,11"
                                        VerticalAlignment="Center"
                                        Click="MemoryOpenPassageModal_Click" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock x:Name="MemoryEmptyState"
                                           Text="No memory passages yet. Add one above and begin with every word visible."
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="360" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="MemoryPassageItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="330" Height="198" Margin="8">
                                                    <Border Background="#050505"
                                                            BorderBrush="#050505"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Margin="0,10,10,0" />
                                                    <Border x:Name="MemoryPaperSheet"
                                                            Width="318"
                                                            Height="186"
                                                            Padding="18"
                                                            Background="{DynamicResource TextPrimary}"
                                                            BorderBrush="#111111"
                                                            BorderThickness="1.5"
                                                            CornerRadius="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="MemoryPaperSheetTransform" />
                                                        </Border.RenderTransform>
                                                        <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Reference}"
                                                                           Foreground="#111111"
                                                                           FontSize="19"
                                                                           FontWeight="Black" />
                                                                <TextBlock Text="{Binding StageLabel}"
                                                                           Foreground="{DynamicResource PanelBackground}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource MemoryCardRemoveButtonStyle}"
                                                                    Width="34" Height="34"
                                                                    Content="×"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Remove passage"
                                                                    Click="MemoryRemovePassage_Click" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Preview}"
                                                                   Foreground="#333333"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="62"
                                                                   Margin="0,14,0,14" />
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding PracticeDetail}"
                                                                       Foreground="{DynamicResource PanelBackground}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource AccentButtonStyle}"
                                                                    Content="Practice"
                                                                    Padding="16,9"
                                                                    Tag="{Binding}"
                                                                    Click="MemoryPractice_Click" />
                                                        </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <Grid.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="MemoryPaperSheetTransform" Storyboard.TargetProperty="X" To="6" Duration="0:0:0.14" />
                                                                    <DoubleAnimation Storyboard.TargetName="MemoryPaperSheetTransform" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="MemoryPaperSheetTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" />
                                                                    <DoubleAnimation Storyboard.TargetName="MemoryPaperSheetTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Grid.Triggers>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <Grid x:Name="MemoryPracticeView"
                              Visibility="Collapsed"
                              Focusable="True"
                              PreviewTextInput="MemoryPracticeView_PreviewTextInput"
                              PreviewKeyDown="MemoryPracticeView_PreviewKeyDown"
                              MouseLeftButtonDown="MemoryPracticeView_MouseLeftButtonDown">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource PanelToolbarButtonStyle}"
                                        Width="42" Height="42" Padding="0"
                                        ToolTip="Back to memory library"
                                        Click="MemoryPracticeBack_Click">
                                    <Path Data="{StaticResource ChevronLeftIcon}"
                                          Stroke="{DynamicResource TextPrimary}"
                                          StrokeThickness="2"
                                          Width="14" Height="14" />
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock x:Name="MemoryPracticeReference"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="22"
                                               FontWeight="Black" />
                                    <TextBlock x:Name="MemoryPracticeStage"
                                               Foreground="{DynamicResource Mint}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource StrokeSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="3"
                                        Margin="12,0,14,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="MemoryTypingModeButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Content="Typing"
                                                Tag="Typing"
                                                MinWidth="72"
                                                Height="34"
                                                Padding="10,0"
                                                ToolTip="Type the verse from memory"
                                                Click="MemoryPracticeMode_Click" />
                                        <Button x:Name="MemoryVisualModeButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Content="Visual"
                                                Tag="Visual"
                                                MinWidth="72"
                                                Height="34"
                                                Padding="10,0"
                                                Margin="3,0,0,0"
                                                ToolTip="Reveal and hide each verse"
                                                Click="MemoryPracticeMode_Click" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MemoryPracticeSectionProgress"
                                           Grid.Column="3"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="42,28">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <RichTextBox x:Name="MemoryPracticeTextView"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="False"
                                                 IsDocumentEnabled="True"
                                                 Focusable="False"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 FontFamily="Segoe UI"
                                                 FontSize="28"
                                                 Padding="0"
                                                 VerticalAlignment="Center"
                                                 MaxHeight="340"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 VerticalScrollBarVisibility="Disabled">
                                        <FlowDocument PagePadding="0" LineHeight="44">
                                            <Paragraph x:Name="MemoryPracticeParagraph" Margin="0" />
                                        </FlowDocument>
                                    </RichTextBox>
                                    <Canvas x:Name="MemoryPracticeCaretLayer" IsHitTestVisible="False">
                                        <Border x:Name="MemorySmoothCaret"
                                                Width="2.5"
                                                Height="34"
                                                Background="{DynamicResource Mint}"
                                                CornerRadius="1.25" />
                                    </Canvas>
                                </Grid>
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="MemoryPracticeFeedback"
                                               Text="Start typing anywhere"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <Border x:Name="MemoryTypingProgressTrack"
                                            Width="340" Height="4" Background="{DynamicResource AppBackground}"
                                            CornerRadius="2" Margin="0,8,0,0">
                                        <Border x:Name="MemoryTypingProgress"
                                                Background="{DynamicResource Mint}"
                                                CornerRadius="2"
                                                Width="0"
                                                HorizontalAlignment="Left" />
                                    </Border>
                                    <StackPanel x:Name="MemoryPracticeUtilityActions"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,10,0,0">
                                        <Button x:Name="MemoryPreviousPhaseButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="38" Height="38" Padding="0"
                                                ToolTip="Previous phase · more words (Left arrow)"
                                                Click="MemoryPreviousPhase_Click">
                                            <Path Data="{StaticResource ChevronLeftIcon}"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="13" Height="13" />
                                        </Button>
                                        <Button Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="38" Height="38" Padding="0"
                                                Margin="6,0,0,0"
                                                ToolTip="Restart this attempt"
                                                Click="MemoryRestartSection_Click">
                                            <TextBlock Text="↻" FontSize="21" FontWeight="SemiBold" />
                                        </Button>
                                        <Button x:Name="MemoryVersePeekButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="38" Height="38" Padding="0"
                                                Margin="6,0,0,0"
                                                ToolTip="Hover to reveal the whole verse"
                                                MouseEnter="MemoryVersePeek_MouseEnter"
                                                MouseLeave="MemoryVersePeek_MouseLeave">
                                            <Grid Width="17" Height="17">
                                                <Path x:Name="MemoryPeekClosedEye"
                                                      Data="{StaticResource EyeOffIcon}"
                                                      Stroke="{DynamicResource TextPrimary}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform" />
                                                <Path x:Name="MemoryPeekOpenEye"
                                                      Data="{StaticResource EyeOpenIcon}"
                                                      Stroke="{DynamicResource Mint}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MemoryNextPhaseButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="38" Height="38" Padding="0"
                                                Margin="6,0,0,0"
                                                ToolTip="Next phase · fewer words (Right arrow)"
                                                Click="MemoryNextPhase_Click">
                                            <Path Data="{StaticResource ChevronRightIcon}"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="13" Height="13" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="MemoryVisualActions"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                        <Button x:Name="MemoryVisualPreviousVerseButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="42" Height="42" Padding="0"
                                                ToolTip="Previous verse"
                                                Click="MemoryVisualPreviousVerse_Click">
                                            <Path Data="{StaticResource ChevronLeftIcon}"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="14" Height="14" />
                                        </Button>
                                        <Button x:Name="MemoryVisualRevealButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="46" Height="42" Padding="0"
                                                Margin="7,0"
                                                ToolTip="Show verse (Space)"
                                                Click="MemoryVisualReveal_Click">
                                            <Grid Width="19" Height="19">
                                                <Path x:Name="MemoryVisualHiddenEye"
                                                      Data="{StaticResource EyeOffIcon}"
                                                      Stroke="{DynamicResource TextPrimary}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform" />
                                                <Path x:Name="MemoryVisualVisibleEye"
                                                      Data="{StaticResource EyeOpenIcon}"
                                                      Stroke="{DynamicResource Mint}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MemoryVisualNextVerseButton"
                                                Style="{StaticResource PanelToolbarButtonStyle}"
                                                Width="42" Height="42" Padding="0"
                                                ToolTip="Next verse"
                                                Click="MemoryVisualNextVerse_Click">
                                            <Path Data="{StaticResource ChevronRightIcon}"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Border x:Name="MemoryConfidenceCheck"
                                        Visibility="Collapsed"
                                        Opacity="0"
                                        MaxWidth="820"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource Mint}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16,13"
                                        RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="MemoryConfidenceTranslate" Y="8" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Grid Margin="5,0,5,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MemoryConfidenceSummary"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="14"
                                                       FontWeight="Black" />
                                            <TextBlock x:Name="MemoryConfidenceRecommendationText"
                                                       Grid.Column="1"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <UniformGrid Columns="3">
                                            <Button x:Name="MemoryAgainButton"
                                                    Style="{StaticResource MemoryConfidenceButtonStyle}"
                                                    Content="↻  Again"
                                                    Click="MemoryAgain_Click" />
                                            <Button x:Name="MemoryGoodButton"
                                                    Style="{StaticResource MemoryConfidenceButtonStyle}"
                                                    Content="✓  Good, Next Phase"
                                                    Click="MemoryGood_Click" />
                                            <Button x:Name="MemoryNailedButton"
                                                    Style="{StaticResource MemoryConfidenceButtonStyle}"
