        <!-- Polished selects. Kept as an explicit style so it can be verified and evolved independently. -->
        <Style x:Key="PolishedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid x:Name="Row" MinHeight="{TemplateBinding MinHeight}"
                              Background="Transparent" ClipToBounds="True">
                            <Border x:Name="SelectedShade"
                                    Background="{DynamicResource Mint}"
                                    CornerRadius="6"
                                    Opacity="0" />
                            <Border x:Name="HoverShade"
                                    Background="{DynamicResource PanelBackground}"
                                    CornerRadius="6"
                                    Opacity="0" />
                            <Border x:Name="SelectionBar"
                                    Width="3"
                                    Margin="0,7"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Mint}"
                                    CornerRadius="2"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SelectionBarScale" ScaleY="0.35" />
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter x:Name="ItemContent"
                                              ContentSource="Content"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ItemTranslate" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedShade" Property="Opacity" Value="0.2" />
                                <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource Mint}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionBarScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionBarScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.35" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource FloatingSurfaceExitEase}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverShade"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.13"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                            <DoubleAnimation Storyboard.TargetName="ItemTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="3" Duration="0:0:0.16"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverShade"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource FloatingSurfaceExitEase}" />
                                            <DoubleAnimation Storyboard.TargetName="ItemTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource FloatingSurfaceExitEase}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PolishedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,0,40,0" />
            <Setter Property="MaxDropDownHeight" Value="360" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PolishedComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="SelectRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleSurface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="ToggleHoverShade"
                                                        Background="{DynamicResource AppBackground}"
                                                        CornerRadius="8"
                                                        Opacity="0" />
                                                <Border x:Name="ToggleOpenShade"
                                                        Background="{DynamicResource Mint}"
                                                        CornerRadius="8"
                                                        Opacity="0" />
                                                <Border Width="36"
                                                        HorizontalAlignment="Right"
                                                        Background="{DynamicResource AppBackground}"
                                                        CornerRadius="0,8,8,0"
                                                        Opacity="0.22" />
                                                <Path Width="14" Height="10"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,11,0"
                                                      Data="{StaticResource ChevronDownIcon}"
                                                      Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ToggleHoverShade"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.28" Duration="0:0:0.14"
                                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ToggleHoverShade"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.1"
                                                                             EasingFunction="{StaticResource FloatingSurfaceExitEase}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource Mint}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ToggleOpenShade"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.12" Duration="0:0:0.16"
                                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="180" Duration="0:0:0.2"
                                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ToggleOpenShade"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.11"
                                                                             EasingFunction="{StaticResource FloatingSurfaceExitEase}" />
                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="0" Duration="0:0:0.16"
                                                                             EasingFunction="{StaticResource FloatingSurfaceExitEase}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownSurface"
                                        Background="{DynamicResource AppBackground}"
                                        BorderBrush="{DynamicResource Mint}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4"
                                        Margin="0,7,0,10"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20"
                                                          ShadowDepth="7" Opacity="0.42" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="DropDownScale" ScaleX="0.98" ScaleY="0.92" />
                                            <TranslateTransform x:Name="DropDownTranslate" Y="-8" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <ScrollViewer HorizontalContentAlignment="Stretch"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar"
                                                   BasedOn="{StaticResource {x:Type ScrollBar}}">
                                                <Setter Property="Tag" Value="CompactSelect" />
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter HorizontalAlignment="Stretch" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource Mint}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource Mint}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DropDownSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                            <DoubleAnimation Storyboard.TargetName="DropDownScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.98" To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                            <DoubleAnimation Storyboard.TargetName="DropDownScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.92" To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                            <DoubleAnimation Storyboard.TargetName="DropDownTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-8" To="0" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource FloatingSurfaceEntranceEase}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectRoot" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarRoot"
                Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="#111111"
                BorderThickness="0,0,2,0"
                Padding="22"
                Loaded="SidebarRoot_Loaded">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Canvas x:Name="NavTabIndicatorLayer"
                        Grid.RowSpan="3"
                        Panel.ZIndex="0"
                        IsHitTestVisible="False">
                    <Border x:Name="NavTabIndicator"
                            Width="240"
                            Height="48"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource Mint}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Opacity="1" />
                </Canvas>

                <StackPanel Panel.ZIndex="1">
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SidebarToggleButton"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{DynamicResource AppBackground}"
                                HorizontalAlignment="Right"
                                Click="SidebarToggle_Click"
                                ToolTip="Collapse sidebar">
                            <Grid Width="16" Height="14">
                                <Border Height="2"
                                        Background="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Top"
                                        CornerRadius="1" />
                                <Border Height="2"
                                        Background="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"
                                        CornerRadius="1" />
                                <Border Height="2"
                                        Background="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="1" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Button x:Name="BibleStudyNavButton"
                            Style="{StaticResource ActiveNavButtonStyle}"
                            PreviewMouseLeftButtonDown="SidebarNavButton_PreviewMouseLeftButtonDown"
                            Click="BibleStudyNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BibleStudyNavText"
                                       Text="Bible Study"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>

                    <Button x:Name="TodayNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            PreviewMouseLeftButtonDown="SidebarNavButton_PreviewMouseLeftButtonDown"
                            Click="TodayDashboard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StudyNotesNavText"
                                       Text="Today"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>

                    <Button x:Name="ScriptureMemoryNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            PreviewMouseLeftButtonDown="SidebarNavButton_PreviewMouseLeftButtonDown"
                            Click="ScriptureMemoryNav_Click">
                        <Grid>
                            <TextBlock x:Name="ScriptureMemoryNavText"
                                       Text="Scripture Memory"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            PreviewMouseLeftButtonDown="SidebarNavButton_PreviewMouseLeftButtonDown"
                            Click="Settings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsNavText"
                                       Text="Settings"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>

                    <Button x:Name="PrayerBoardNavButton" Style="{StaticResource NavButtonStyle}" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrayerBoardNavText"
                                       Text="Prayer Board"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>

                    <Button x:Name="ReadingPlanNavButton" Style="{StaticResource NavButtonStyle}" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReadingPlanNavText"
                                       Text="Reading Plan"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>

                    <Button x:Name="ResourceLibraryNavButton" Style="{StaticResource NavButtonStyle}" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResourceLibraryNavText"
                                       Text="Resource Library"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <Grid x:Name="MainContentRoot"
              Grid.Column="1"
              Margin="28"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HeaderBackButton"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{DynamicResource PanelBackground}"
                            Click="BackOneLevel_Click"
                            ToolTip="Back"
                            Visibility="Collapsed"
                            Margin="0,1,14,0">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource ChevronLeftIcon}"
                                  Stroke="{DynamicResource TextPrimary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Button>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="MainHeading"
                                   Text="Bible Study"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="32"
                                   FontWeight="Black" />
                        <TextBlock x:Name="MainSubheading"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="BreadcrumbTrail"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <Border x:Name="WorkspaceStatusCard"
                        Grid.Column="1"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource StrokeSoft}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18,12"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Library"
                                   Foreground="{DynamicResource Gold}"
                                   FontWeight="Bold"
                                   Margin="0,0,10,0" />
                        <TextBlock x:Name="WorkspaceCountText"
                                   Text="66 books ready"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="StudyChatToggleButton"
                            Style="{StaticResource ChromeButtonStyle}"
                            Background="{DynamicResource AppBackground}"
                            BorderBrush="{DynamicResource StrokeSoft}"
                            Padding="13,9"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding Visibility, ElementName=PassagePickerCard}"
                            ToolTip="Open local study chat"
                            Click="ToggleStudyChat_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦"
                                       Foreground="{DynamicResource Mint}"
                                       FontSize="16"
                                       FontWeight="Black"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Study chat"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PassagePickerCard"
                        Style="{StaticResource ChromeButtonStyle}"
                        Background="{DynamicResource AppBackground}"
                        BorderBrush="{DynamicResource StrokeSoft}"
                        Padding="14,9"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTip="Choose the scripture passage"
                        Click="OpenStudyPassageModal_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PASSAGE"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       FontWeight="Black" />
                            <TextBlock x:Name="PassagePreviewText"
                                       Foreground="{DynamicResource Mint}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="250"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Viewbox Grid.Column="1"
                                 Width="14" Height="14"
                                 Margin="14,0,2,0"
                                 VerticalAlignment="Center">
                            <Path Data="{StaticResource ChevronRightIcon}"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="ContentShell"
                    Grid.Row="1"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource StrokeSoft}"
                    BorderThickness="1"
                    CornerRadius="28"
                    Padding="24">
                <Grid>
                    <Grid x:Name="TodayPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="TodayScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="TodayScrollViewer_PreviewMouseWheel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource AppBackground}"
                                    BorderBrush="{DynamicResource StrokeSoft}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Edited Studies"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="18"
                                                       FontWeight="Bold" />
                                        <TextBlock Text="Files touched today, grouped by the study they belong to."
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource PanelBackground}"
                                                CornerRadius="14"
                                                Padding="12,8"
                                                VerticalAlignment="Top"
                                                Margin="12,0,0,0">
                                            <TextBlock x:Name="TodayEditedCountText"
                                                       Foreground="{DynamicResource Mint}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="EmptyTodayText"
                                                   Text="No studies edited today yet."
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="TodayEditedItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource CardButtonStyle}"
                                                                Click="TodayStudy_Click"
                                                                Tag="{Binding Study}"
                                                                Margin="0,0,0,12">
                                                            <Border Background="{DynamicResource PanelBackground}"
                                                                    BorderBrush="{DynamicResource StrokeSoft}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="16"
                                                                    Padding="16">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding StudyName}"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               FontSize="18"
                                                                               FontWeight="Black"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Text="{Binding LocationLabel}"
                                                                               Foreground="{DynamicResource TextSecondary}"
                                                                               Margin="0,6,0,0"
                                                                               TextWrapping="Wrap" />
                                                                    <Grid Grid.Row="2"
                                                                          Margin="0,12,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding PassageLabel}"
                                                                                  Foreground="{DynamicResource Mint}"
                                                                                  FontWeight="SemiBold"
                                                                                  TextWrapping="Wrap" />
                                                                        <StackPanel Grid.Column="1"
                                                                                    Orientation="Horizontal"
                                                                                    Margin="14,0,0,0">
                                                                            <TextBlock Text="{Binding LastEditedLabel}"
                                                                                       Foreground="{DynamicResource TextMuted}"
                                                                                       FontSize="12"
                                                                                       VerticalAlignment="Center" />
                                                                            <Button Style="{StaticResource RemoveButtonStyle}"
                                                                                    Margin="8,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Tag="{Binding ContextKey}"
                                                                                    ToolTip="Remove from AI context"
                                                                                    Click="RemoveTodayEditedStudyContext_Click">
                                                                                <TextBlock Text="X"
                                                                                           FontSize="12"
                                                                                           FontWeight="Black" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Background="{DynamicResource Mint}"
                                    Opacity="0.65"
                                    Margin="15,4" />

                            <StackPanel Grid.Column="2">
                                <Border Background="{DynamicResource AppBackground}"
                                        BorderBrush="{DynamicResource StrokeSoft}"
                                        BorderThickness="1"
                                        CornerRadius="22"
                                        Padding="18"
                                        Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Details For The Day"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="18"
                                                   FontWeight="Bold" />
                                        <Grid Margin="0,12,0,0">
                                            <TextBox x:Name="DailyDetailsTextBox"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="120"
                                                     Background="{DynamicResource PanelBackground}"
                                                     BorderBrush="{DynamicResource StrokeSoft}"
                                                     BorderThickness="1"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     CaretBrush="{DynamicResource Mint}"
                                                     Padding="12"
                                                     TextChanged="DailyDetails_TextChanged" />
                                            <TextBlock x:Name="DailyDetailsPlaceholderText"
                                                       Text="Add information about your life right now so it can be taken into account when sending you messages"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="13,10,13,0"
                                                       TextWrapping="Wrap"
                                                       IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource AppBackground}"
                                        BorderBrush="{DynamicResource StrokeSoft}"
                                        BorderThickness="1"
